# Server
PORT=4000
NODE_ENV=development

# MySQL
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/school_management"

# Auth — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to start if missing or set to a known default value.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS — comma-separated list of allowed origins (no wildcards)
CORS_ORIGIN=http://localhost:5173
